[
  {
    "id": "rule-nep-airport-buffer-001",
    "name": "Airport Boundary Safety Restriction",
    "priority": 100,
    "conditions": [
      {
        "field": "distanceToAirport",
        "operator": "<",
        "value": 5000
      }
    ],
    "result": {
      "status": "Prohibited",
      "reason": "Flight is within the 5 km aerodrome buffer zone. Operations near active movement areas are prohibited for civil safety.",
      "riskSurcharge": {
        "safety": 50,
        "legal": 40
      }
    },
    "citation": {
      "authorityId": "auth-nep-caan-001",
      "legalBasis": "UASR Reg. 101.7(b)(5) & Reg. 101.23",
      "officialCircular": "CAAN UAS Requirements 2021",
      "lastVerified": "2026-06-30"
    },
    "metadata": {
      "effectiveDate": "2021-06-30",
      "expiryDate": null,
      "revision": 1,
      "supersedesId": null
    }
  },
  {
    "id": "rule-nep-altitude-limit-001",
    "name": "Maximum Flight Altitude Limitation",
    "priority": 90,
    "conditions": [
      {
        "field": "altitudeAgl",
        "operator": ">",
        "value": 100
      }
    ],
    "result": {
      "status": "Restricted",
      "reason": "Flight altitude exceeds the 100 meters (328 ft) AGL ceiling. Operations above this limit require segregated airspace or special NOTAM clearance.",
      "riskSurcharge": {
        "safety": 30,
        "operational": 20
      }
    },
    "citation": {
      "authorityId": "auth-nep-caan-001",
      "legalBasis": "UASR Reg. 101.7(a)(1) & Reg. 101.25",
      "officialCircular": "CAAN UAS Requirements 2021",
      "lastVerified": "2026-06-30"
    },
    "metadata": {
      "effectiveDate": "2021-06-30",
      "expiryDate": null,
      "revision": 1,
      "supersedesId": null
    }
  },
  {
    "id": "rule-nep-national-park-001",
    "name": "Protected Wildlife and Conservation Area Restriction",
    "priority": 85,
    "conditions": [
      {
        "field": "insideNationalPark",
        "operator": "==",
        "value": true
      }
    ],
    "result": {
      "status": "Restricted",
      "reason": "Flight coordinate is within a national park or wildlife reserve. Requires prior permit clearance from the DNPWC to protect local ecology.",
      "riskSurcharge": {
        "environmental": 40,
        "legal": 20
      }
    },
    "citation": {
      "authorityId": "auth-nep-dnpwc-001",
      "legalBasis": "National Parks and Wildlife Conservation Act, 2029 (Section 22)",
      "officialCircular": "DNPWC Drone Guidelines 2075",
      "lastVerified": "2026-06-30"
    },
    "metadata": {
      "effectiveDate": "2018-09-01",
      "expiryDate": null,
      "revision": 1,
      "supersedesId": null
    }
  },
  {
    "id": "rule-nep-heritage-site-001",
    "name": "UNESCO Heritage & Archaeological Monuments Protection",
    "priority": 80,
    "conditions": [
      {
        "field": "insideHeritageSite",
        "operator": "==",
        "value": true
      }
    ],
    "result": {
      "status": "Restricted",
      "reason": "Flight coordinate is inside a UNESCO World Heritage site or protected archaeological area. Requires Department of Archaeology filming clearance.",
      "riskSurcharge": {
        "privacy": 30,
        "legal": 25
      }
    },
    "citation": {
      "authorityId": "auth-nep-doa-001",
      "legalBasis": "Ancient Monuments Preservation Act, 2013 (Section 12)",
      "officialCircular": "DoA Heritage Filming Procedure",
      "lastVerified": "2026-06-30"
    },
    "metadata": {
      "effectiveDate": "2015-05-15",
      "expiryDate": null,
      "revision": 1,
      "supersedesId": null
    }
  },
  {
    "id": "rule-nep-foreign-pilot-001",
    "name": "Foreign National Operator screening",
    "priority": 70,
    "conditions": [
      {
        "field": "pilot.nationality",
        "operator": "==",
        "value": "Foreign"
      }
    ],
    "result": {
      "status": "Permit Required",
      "reason": "Foreign national pilots are subject to mandatory security clearance and must operate under a local agency sponsor.",
      "riskSurcharge": {
        "legal": 20
      }
    },
    "citation": {
      "authorityId": "auth-nep-moha-001",
      "legalBasis": "MoHA UAV Working Procedure 2075 (Section 4.3)",
      "officialCircular": "MoHA UAV Drone Policy Statement",
      "lastVerified": "2026-06-30"
    },
    "metadata": {
      "effectiveDate": "2019-01-01",
      "expiryDate": null,
