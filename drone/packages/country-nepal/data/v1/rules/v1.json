  {
    "id": "rule-nep-gross-weight-limit-001",
    "name": "Maximum Takeoff Weight Part 101 Envelope Cap",
    "priority": 110,
    "conditions": [
      {
        "field": "drone.weightGrams",
        "operator": ">",
        "value": 25000
      }
    ],
    "result": {
      "status": "Prohibited",
      "reason": "Drone weight exceeds 25 kg. Operations of this size fall outside standard civilian open frameworks and are generally prohibited for private safety.",
      "riskSurcharge": {
        "safety": 50,
        "operational": 40
      }
    },
    "citation": {
      "authorityId": "auth-nep-caan-001",
      "legalBasis": "UASR Reg. 101.37",
      "officialCircular": "CAAN UAS Requirements 2021",
      "lastVerified": "2026-06-30"
    },
    "metadata": {
