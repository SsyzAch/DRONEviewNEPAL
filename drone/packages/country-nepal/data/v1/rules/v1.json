      "supersedesId": null
    }
  },
  {
    "id": "rule-nep-commercial-purpose-001",
    "name": "Commercial and Aerial Mapping Operations",
    "priority": 65,
    "conditions": [
      {
        "field": "pilot.purpose",
        "operator": "==",
        "value": "Commercial"
      }
    ],
    "result": {
      "status": "Permit Required",
      "reason": "Commercial flight purposes (e.g. mapping, filming, inspection) require technical approvals and validation of third-party insurance.",
      "riskSurcharge": {
        "operational": 10,
        "privacy": 15
      }
    },
    "citation": {
      "authorityId": "auth-nep-caan-001",
      "legalBasis": "UASR Reg. 101.5 & Part 102",
      "officialCircular": "CAAN Operational Directives",
      "lastVerified": "2026-06-30"
    },
    "metadata": {
      "effectiveDate": "2021-06-30",
