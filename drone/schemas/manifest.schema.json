{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DatasetManifest",
  "type": "object",
  "required": [
    "dataset",
    "version",
    "recordCount",
    "coordinateSystem",
    "generatedFrom",
    "lastVerified",
    "checksum"
  ],
  "properties": {
    "dataset": { "type": "string" },
    "version": { "type": "string" },
    "recordCount": { "type": "integer" },
    "coordinateSystem": { "type": "string" },
    "generatedFrom": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lastVerified": { "type": "string" },
    "checksum": { "type": "string" }
  }
}
